<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_thread.LLMChatMessageList" >
        <div
        class="o_MessageList bg-view d-flex flex-column overflow-auto"
        t-att-class="{ 'o-empty align-items-center justify-content-center': state.messages.length === 0, 'pb-4': state.messages.length !== 0 }"
        t-ref="root"
      >
            <!-- Loading State -->
            <t t-if="state.isLoading">
                <div class="d-flex justify-content-center align-items-center p-4">
                    <i class="fa fa-spin fa-circle-o-notch me-2" />
                    Loading messages...
                </div>
            </t>
            
            <!-- Messages -->
            <t t-else="">
                <t t-if="state.messages.length === 0">
                    <div class="text-center text-muted p-4">
                        <i class="fa fa-comments-o fa-3x mb-3 d-block" />
                        No messages yet. Start the conversation!
                    </div>
                </t>
                <t t-else="">
                    <t t-foreach="state.messages" t-as="message" t-key="message.id">
                        <div class="o_MessageList_item mb-3 px-3">
                            <div class="d-flex">
                                <!-- Author -->
                                <div class="me-3 flex-shrink-0">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                                         style="width: 32px; height: 32px; font-size: 14px;">
                                        <t t-if="message.author_id">
                                            <t t-esc="message.author_id[1] ? message.author_id[1][0] : 'U'" />
                                        </t>
                                        <t t-else="">
                                            AI
                                        </t>
                                    </div>
                                </div>
                                <!-- Message content -->
                                <div class="flex-grow-1">
                                    <div class="fw-bold mb-1">
                                        <t t-if="message.author_id">
                                            <t t-esc="message.author_id[1]" />
                                        </t>
                                        <t t-else="">
                                            AI Assistant
                                        </t>
                                    </div>
                                    <div t-out="message.body" class="message-content" />
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
            
            <!-- Streaming Indicator -->
            <t t-if="props.isStreaming">
                <LLMStreamingIndicator />
            </t>
        </div>
    </t>

</templates>
