<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- Sub-templates -->
  <t t-name="llm_thread.Message.AssistantContent">
    <t t-if="!state.isEditing">
      <div class="o-mail-Message-prettyBody o_Message_prettyBody" t-ref="prettyBody"/>
    </t>
    <t t-if="message.toolCalls && message.toolCalls.length">
      <div class="o_llm_tool_calls mt-2 small text-muted border-top pt-1">
        <strong class="me-1">Tools Requested:</strong>
        <t t-foreach="message.toolCalls" t-as="toolCall" t-key="toolCall.id">
          <span class="badge bg-light text-dark border me-1 mb-1"
                t-att-title="'ID: ' + toolCall.id + '\nArgs: ' + (toolCall.function?.arguments || '')">
            <i class="fa fa-cog me-1" aria-hidden="true"/>
            <t t-esc="toolCall.function?.name"/>
          </span>
        </t>
      </div>
    </t>
  </t>

  <t t-name="llm_thread.Message.ToolResultContent">
    <div class="o-mail-Message-prettyBody o_Message_prettyBody o_llm_tool_result">
      <div class="o_llm_tool_result_header small mb-1">
        <p class="mb-2" t-ref="prettyBody"/>
        <strong class="me-2">
          <i t-attf-class="fa me-1 {{ message.toolCallResultIsError ? 'fa-exclamation-circle text-danger' : 'fa-check-circle text-success' }}"/>
          Tool:
          <t t-esc="message.toolName || message.toolCallDefinitionFormatted?.function?.name || 'Unknown Tool'"/>
        </strong>
        <span class="text-muted small">(ID: <t t-esc="message.toolCallId || 'N/A'"/>)</span>
      </div>

      <details class="o_llm_tool_result_args mb-1">
        <summary class="text-muted" style="cursor:pointer;"><strong class="small">Arguments</strong></summary>
        <pre class="bg-light p-1 rounded small mt-1"><code t-esc="message.toolCallDefinitionFormatted?.function?.arguments || '{}'"/></pre>
      </details>

      <div class="o_llm_tool_result_content mt-1">
        <details>
          <summary class="text-muted" style="cursor:pointer;"><strong class="small">Result</strong></summary>
          <t t-if="message.toolCallResultIsError">
            <pre class="bg-danger-light border border-danger text-danger p-1 rounded small mt-1">
<code t-esc="message.toolCallResultData?.error || 'Unknown Error'"/></pre>
          </t>
          <t t-else="">
            <pre class="bg-light border p-1 rounded small mt-1">
<code t-esc="message.toolCallResultFormatted"/></pre>
          </t>
        </details>
      </div>
    </div>
  </t>

  <t t-name="llm_thread.Message.DefaultContent">
    <t t-if="!state.isEditing">
      <div class="o-mail-Message-prettyBody o_Message_prettyBody" t-ref="prettyBody"/>
    </t>
    <t t-if="state.isEditing">
      <Composer autofocus="true"
                composer="message.composer"
                messageComponent="constructor"
                onDiscardCallback.bind="exitEditMode"
                onPostCallback.bind="exitEditMode"
                mode="env.inChatter ? 'extended' : 'compact'"
                sidebar="false"/>
    </t>
    <t t-if="showSubtypeDescription" t-out="props.messageSearch?.highlight(message.subtype_description) ?? message.subtype_description"/>
  </t>

  <!-- Extensión del cuerpo -->
  <t t-name="llm_thread.MessageExtension"
     t-inherit="mail.Message"
     t-inherit-mode="extension">

    <xpath expr="//div[contains(@class,'o-mail-Message-body')]" position="replace">
      <div class="position-relative text-break o-mail-Message-body"
           t-att-class="{
             'p-1': message.is_note,
             'mb-0 py-2 px-3': !message.is_note,
             'align-self-start rounded-end-3 rounded-bottom-3': !state.isEditing && !message.is_note,
             'o-mail-Message-editable flex-grow-1': state.isEditing,
           }"
           t-ref="body">

        <t t-if="state.isEditing">
          <Composer autofocus="true"
                    composer="message.composer"
                    messageComponent="constructor"
                    onDiscardCallback.bind="exitEditMode"
                    onPostCallback.bind="exitEditMode"
                    mode="env.inChatter ? 'extended' : 'compact'"
                    sidebar="false"/>
        </t>

        <t t-else="">
          <em t-if="message.subject and !message.isSubjectSimilarToOriginThreadName and !message.isSubjectDefault"
              class="mb-1 me-2">Subject:
            <t t-out="props.messageSearch?.highlight(message.subject) ?? message.subject"/>
          </em>

          <t t-if="message.llmRole === 'assistant'">
            <t t-call="llm_thread.Message.AssistantContent"/>
          </t>
          <t t-elif="message.llmRole === 'tool'">
            <t t-call="llm_thread.Message.ToolResultContent"/>
          </t>
          <t t-else="">
            <div class="overflow-x-auto" t-if="message.type && message.type.includes('email')" t-ref="shadowBody"/>
            <t t-elif="state.showTranslation" t-out="message.translationValue"/>
            <t t-elif="message.body" t-out="props.messageSearch?.highlight(message.body) ?? message.body"/>
            <p class="fst-italic text-muted small" t-if="state.showTranslation">
              <t t-if="message.translationSource" t-esc="translatedFromText"/>
            </p>
            <p class="fst-italic text-muted small" t-if="message.translationErrors">
              <i class="text-danger fa fa-warning" role="img" aria-label="Translation Failure"/>
              <t t-if="message.translationErrors" t-esc="translationFailureText"/>
            </p>
            <t t-if="showSubtypeDescription" t-out="props.messageSearch?.highlight(message.subtype_description) ?? message.subtype_description"/>
          </t>
        </t>
      </div>
    </xpath>
  </t>

</templates>
