<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="llm_thread.ChatterTopbar"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <!-- Insert AI button before the topbar grow spacer -->
        <xpath
            expr="//span[hasclass('o-mail-Chatter-topbarGrow')]"
            position="before"
        >
            <!-- AI Chat Button inserted in the flex area -->
            <button
                t-attf-class="o-mail-Chatter-ai btn btn-secondary text-nowrap me-1 {{ chatter.is_chatting_with_llm ? 'btn-primary o-active' : 'btn-secondary' }}"
                t-att-class="{ 'my-2': !props.compactHeight }"
                type="button"
                t-on-click="chatter.toggleLLMChat"
                data-hotkey="shift+i"
            >
                <span>AI Chat</span>
            </button>
        </xpath>
    </t>
</templates>
