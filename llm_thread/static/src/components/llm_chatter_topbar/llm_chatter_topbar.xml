<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="llm_thread.ChatterExtension"
     t-inherit="mail.Chatter"
     t-inherit-mode="extension"
     owl="1">

    <!-- Caso A: insertar DESPUÉS del botón Activities -->
    <xpath expr="//div[contains(@class,'o-mail-Chatter-topbar')]//button[hasclass('o-mail-Chatter-activity')]"
           position="after">
      <span class="ms-2" style="border-left: 1px solid var(--border); height: auto;"></span>
      <button
        class="o-mail-Chatter-llm btn text-nowrap ms-2"
        t-att-class="(state.is_chatting_with_llm ? 'btn-primary active' : 'btn-secondary') + (props.compactHeight ? '' : ' my-2')"
        t-att-disabled="!props.threadId"
        t-on-click="toggleLLMChat">
        <span>AI</span>
      </button>
    </xpath>

    <!-- Caso B: si no hay Activities, insertar ANTES del spacer -->
    <xpath expr="//div[contains(@class,'o-mail-Chatter-topbar')]//span[hasclass('o-mail-Chatter-topbarGrow')]"
           position="before">
      <button
        class="o-mail-Chatter-llm btn text-nowrap me-2"
        t-att-class="(state.is_chatting_with_llm ? 'btn-primary active' : 'btn-secondary') + (props.compactHeight ? '' : ' my-2')"
        t-att-disabled="!props.threadId"
        t-on-click="toggleLLMChat">
        <span>AI</span>
      </button>
    </xpath>

  </t>
</templates>
