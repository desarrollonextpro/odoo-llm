<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="llm_thread.ChatterTopbar"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <!-- Insert AI button after the Activities button in the topbar -->
        <xpath
            expr="//button[hasclass('o-mail-Chatter-activity')]"
            position="after"
        >
            <!-- AI Chat Button inserted next to Activities -->
            <button
                t-attf-class="o-mail-Chatter-ai btn btn-secondary text-nowrap ms-1 {{ chatter.is_chatting_with_llm ? 'btn-primary o-active' : 'btn-secondary' }}"
                t-att-class="{ 'my-2': !props.compactHeight }"
                type="button"
                t-on-click="chatter.toggleLLMChat"
                data-hotkey="shift+i"
            >
                <span>AI Chat</span>
            </button>
        </xpath>
    </t>
</templates>
