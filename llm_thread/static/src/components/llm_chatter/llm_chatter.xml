<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="llm_thread.Chatter"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <!-- Instead of replacing, let's extend the existing structure -->
        <!-- Add our custom topbar -->
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]" position="before">
            <ChatterTopbar
                t-if="chatter.topbar"
                className="'o-mail-Chatter-topbar'"
                record="chatter.topbar"
            />
        </xpath>
        
        <!-- Add conditional content based on is_chatting_with_llm -->
        <xpath expr="//div[hasclass('o-mail-Chatter-content')]" position="replace">
            <t t-if="chatter.is_chatting_with_llm and chatter.llmChatThread">
                <!-- AI Chat Mode: Only show LLMChatThread -->
                <div class="o-mail-Chatter-content d-flex flex-column flex-grow-1">
                    <LLMChatThread
                        className="'o-mail-Chatter-thread flex-grow-1'"
                        record="chatter.llmChatThread"
                        threadView="chatter.llmChatThreadView"
                    />
                </div>
            </t>
            <t t-else="">
                <!-- Normal Mode: Show original Chatter content -->
                <div class="o-mail-Chatter-content d-flex flex-column flex-grow-1">
                    <t t-if="chatter.dropZoneView">
                        <DropZone
                            className="'o-mail-Chatter-dropZone'"
                            record="chatter.dropZoneView"
                        />
                    </t>
                    <div class="o-mail-Chatter-fixedPanel">
                        <t t-if="chatter.composerView">
                            <Composer
                                className="'o-mail-Chatter-composer border-bottom'"
                                classNameObj="{ 'o-bordered': chatter.hasExternalBorder }"
                                record="chatter.composerView"
                            />
                        </t>
                    </div>
                    <div
                        class="o-mail-Chatter-scrollPanel overflow-auto flex-grow-1"
                        t-on-scroll="chatter.onScrollScrollPanel"
                        t-ref="scrollPanel"
                    >
                        <t t-if="chatter.attachmentBoxView">
                            <AttachmentBox
                                className="'o-mail-Chatter-attachmentBox'"
                                record="chatter.attachmentBoxView"
                            />
                        </t>
                        <t t-if="chatter.activityBoxView">
                            <ActivityBox
                                className="'o-mail-Chatter-activityBox'"
                                record="chatter.activityBoxView"
                            />
                        </t>
                        <t t-if="chatter.threadView">
                            <ThreadView
                                className="'o-mail-Chatter-thread'"
                                record="chatter.threadView"
                            />
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
